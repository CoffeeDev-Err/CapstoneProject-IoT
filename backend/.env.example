NODE_ENV=development
PORT=4000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
ALLOWED_ORIGINS=http://localhost:5600
# Optional absolute directory outside the deployment folder for persistent uploads.
# UPLOAD_DIR=/home/<hostinger-user>/domains/<domain>/storage/uploads
FLESPI_TOKEN=replace-with-a-restricted-flespi-token
FLESPI_SYNC_INTERVAL_MS=3000
FLESPI_MQTT_ENABLED=true
FLESPI_MQTT_URL=mqtts://mqtt.flespi.io:8883
FLESPI_MQTT_TOPIC=flespi/state/gw/devices/+/telemetry/+
FLESPI_MQTT_DEBOUNCE_MS=250
DEPLOYMENT_STATUS_INTERVAL_MS=15000
SHIFT_REMINDER_MINUTES=30
INACTIVITY_ALERT_MINUTES=5
MOVEMENT_THRESHOLD_METERS=20
GPS_LOCATION_STALE_SECONDS=120
GPS_INGEST_API_KEY=replace-with-a-long-random-secret
OTP_SECRET=replace-with-another-long-random-secret
REVERSE_GEOCODING_ENABLED=true
REVERSE_GEOCODING_URL=https://nominatim.openstreetmap.org/reverse
REVERSE_GEOCODING_USER_AGENT=BantayCabagan-Capstone/1.0

# Use "console" while developing, then switch to "gmail".
EMAIL_DELIVERY_MODE=console
GMAIL_USER=bantaycabagan.system@gmail.com
GMAIL_APP_PASSWORD=replace-with-a-16-character-google-app-password
EMAIL_BRAND_NAME=GeoSentri
EMAIL_FROM_NAME=GeoSentri
EMAIL_FROM=GeoSentri <geosentri.system@gmail.com>

# Existing supervisor accounts without an email can use this migration fallback.
SUPERVISOR_EMAIL=supervisor@example.com
SUPERVISOR_LOGIN_ID=supervisor
SUPERVISOR_TEMP_PASSWORD=ChangeMe!2026
DEMO_OFFICER_LOGIN_ID=officer.demo
DEMO_OFFICER_FULL_NAME=GPS-Linked Officer
DEMO_OFFICER_EMAIL=officer@example.com
DEMO_OFFICER_TEMP_PASSWORD=OfficerDemo!2026
DEMO_OFFICER_PERSONNEL_ID=pcpl-001
DEMO_GPS_FLESPI_DEVICE_ID=replace-with-flespi-device-id
DEMO_GPS_DEVICE_IDENT=replace-with-sinotrack-device-id
DEMO_GPS_DEVICE_NAME=GPS-001
