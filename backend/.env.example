NODE_ENV=development
PORT=4000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
ALLOWED_ORIGINS=http://localhost:5600
# Required in production. Set to the exact number of trusted reverse proxies.
TRUST_PROXY=0
# Optional absolute directory outside the deployment folder for persistent uploads.
# UPLOAD_DIR=/home/<hostinger-user>/domains/<domain>/storage/uploads
# New profile photos and report evidence use S3 when all four AWS values are set.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=geosentri-private-media-<account-id>-ap-southeast-1-an
AWS_ACCESS_KEY_ID=replace-with-dedicated-iam-access-key
AWS_SECRET_ACCESS_KEY=replace-with-dedicated-iam-secret-key
S3_SIGNED_URL_TTL_SECONDS=900
# Optional dedicated secret; otherwise a domain-separated OTP/AWS secret is used.
MEDIA_URL_SIGNING_SECRET=replace-with-a-long-random-secret
FLESPI_TOKEN=replace-with-a-restricted-flespi-token
FLESPI_SYNC_INTERVAL_MS=3000
FLESPI_MQTT_ENABLED=true
FLESPI_MQTT_URL=mqtts://mqtt.flespi.io:8883
FLESPI_MQTT_TOPIC=flespi/state/gw/devices/+/telemetry/+
FLESPI_MQTT_DEBOUNCE_MS=250
DEPLOYMENT_STATUS_INTERVAL_MS=15000
SHIFT_REMINDER_MINUTES=30
INACTIVITY_ALERT_MINUTES=5
MOVEMENT_THRESHOLD_METERS=20
GEOFENCE_MAX_ACCURACY_METERS=100
GEOFENCE_CONFIRMATION_READINGS=2
BACKUP_ARRIVAL_RADIUS_METERS=50
GPS_LOCATION_STALE_SECONDS=120
GPS_UNAVAILABLE_ALERT_GRACE_SECONDS=120
GPS_INGEST_API_KEY=replace-with-a-long-random-secret
OTP_SECRET=replace-with-another-long-random-secret
REVERSE_GEOCODING_ENABLED=true
REVERSE_GEOCODING_URL=https://nominatim.openstreetmap.org/reverse
REVERSE_GEOCODING_USER_AGENT=BantayCabagan-Capstone/1.0

# Use "console" while developing, then switch to "gmail".
EMAIL_DELIVERY_MODE=console
GMAIL_USER=bantaycabagan.system@gmail.com
GMAIL_APP_PASSWORD=replace-with-a-16-character-google-app-password
EMAIL_BRAND_NAME=GeoSentri
EMAIL_FROM_NAME=GeoSentri
EMAIL_FROM=GeoSentri <geosentri.system@gmail.com>

# Optional: required only if enhanced push security is enabled in Expo/EAS.
# The persistent push worker starts automatically with the backend.
EXPO_ACCESS_TOKEN=

# Existing supervisor accounts without an email can use this migration fallback.
SUPERVISOR_EMAIL=supervisor@example.com
SUPERVISOR_LOGIN_ID=00-0001
SUPERVISOR_FULL_NAME=Juan Dela Cruz
SUPERVISOR_RANK=Police Captain
SUPERVISOR_TEMP_PASSWORD=ChangeMe!2026
# Optional approved OSRM-compatible base URL, e.g. https://matching.example.org
# Empty by default: GPS coordinates are not sent to a public demo provider.
REPORT_MAP_MATCHING_URL=

# Optional OSRM-compatible walking route endpoint for patrols and next-area navigation.
# Leave empty to retain manually plotted foot paths and clearly labeled direction guides.
# Configure a walking profile; do not point this at a driving profile.
OSRM_WALK_ROUTE_URL=
